#directory-picker {
    align: center middle;
    background: rgba(15, 23, 42, 0.78);
}

#picker-card {
    width: 90%;
    height: 90%;
    border: round #38bdf8;
    background: #0b1220;
    padding: 1 2;
}

#picker-title {
    text-style: bold;
    color: #f8fafc;
}

#picker-hint {
    color: #94a3b8;
    margin-bottom: 1;
}

#picker-tree {
    height: 1fr;
    border: round #334155;
    background: #111827;
}

#picker-manual {
    height: auto;
    margin-top: 1;
}

#picker-manual > Label {
    color: #94a3b8;
}

#picker-path {
    width: 1fr;
}

#picker-status {
    margin-top: 1;
    color: #94a3b8;
}

#picker-actions {
    height: auto;
    margin-top: 1;
    layout: horizontal;
}

#picker-actions Button {
    width: 1fr;
}

#picker-actions #picker-cancel {
    margin-left: 1;
}

#output-actions #browse-events,
#output-actions #clear {
    width: 1fr;
}

#event-browser {
    align: center middle;
    background: rgba(15, 23, 42, 0.78);
}

#event-browser-card {
    width: 90%;
    height: 88%;
    border: round #38bdf8;
    background: #0b1220;
    padding: 1 2;
}

#browser-title {
    text-style: bold;
    color: #f8fafc;
}

#browser-page {
    color: #94a3b8;
    height: auto;
}

#browser-sort-hint {
    height: auto;
    color: #7dd3fc;
    margin-bottom: 1;
}

#event-options {
    height: 1fr;
    min-height: 3;
    border: round #334155;
    background: #111827;
}

#browser-preview-content {
    display: none;
    height: 1fr;
    min-height: 1;
}

#source-warning {
    height: auto;
    color: #fbbf24;
    margin-bottom: 1;
}

#source-path {
    height: auto;
    min-height: 3;
    border: round #334155;
    background: #111827;
    color: #7dd3fc;
    padding: 1;
    overflow: auto;
}

#retained-details {
    height: auto;
    border: round #334155;
    background: #111827;
    padding: 1;
    margin-bottom: 1;
}

#source-context {
    height: auto;
    min-height: 5;
    border: round #334155;
    background: #111827;
    padding: 1;
    overflow: auto;
}

#copy-feedback {
    height: auto;
    color: #fbbf24;
    margin-top: 1;
}

#event-browser-actions {
    height: auto;
    margin-top: 1;
    layout: grid;
    grid-size: 3 2;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: auto auto;
    grid-gutter: 0 1;
}

#event-browser-actions Button {
    width: 1fr;
    min-width: 0;
    height: auto;
    margin: 0;
}

#recipe-dialog {
    align: center middle;
    background: rgba(15, 23, 42, 0.78);
}

#recipe-dialog-card {
    width: 90%;
    height: 90%;
    border: round #38bdf8;
    background: #0b1220;
    padding: 1 2;
}

#recipe-content {
    height: 1fr;
    overflow: auto;
}

#recipe-title {
    text-style: bold;
    color: #f8fafc;
    margin-bottom: 1;
}

#recipe-selection,
#recipe-name {
    width: 1fr;
    margin-bottom: 1;
}

#recipe-status {
    height: auto;
    min-height: 1;
    color: #fbbf24;
    margin-top: 1;
}

#recipe-actions {
    height: auto;
    layout: horizontal;
    margin-top: 1;
}

#recipe-actions Button {
    width: 1fr;
    min-width: 8;
    margin-right: 1;
}

#recipe-actions #recipe-close {
    margin-right: 0;
}
