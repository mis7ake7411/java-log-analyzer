#directory-picker {
    align: center middle;
    background: rgba(15, 23, 42, 0.78);
}

#picker-card {
    width: 90%;
    height: 90%;
    border: round #38bdf8;
    background: #0b1220;
    padding: 1 2;
}

#picker-title {
    text-style: bold;
    color: #f8fafc;
}

#picker-hint {
    color: #94a3b8;
    margin-bottom: 1;
}

#picker-tree {
    height: 1fr;
    border: round #334155;
    background: #111827;
}

#picker-manual {
    height: auto;
    margin-top: 1;
}

#picker-manual > Label {
    color: #94a3b8;
}

#picker-path {
    width: 1fr;
}

#picker-status {
    margin-top: 1;
    color: #94a3b8;
}

#picker-actions {
    height: auto;
    margin-top: 1;
    layout: horizontal;
}

#picker-actions Button {
    width: 1fr;
}

#picker-actions #picker-cancel {
    margin-left: 1;
}

#export-conflict {
    align: center middle;
    background: rgba(15, 23, 42, 0.78);
}

#export-conflict-card {
    width: 96%;
    height: 90%;
    border: round #38bdf8;
    background: #0b1220;
    padding: 1 1;
}

#export-conflict-title {
    height: auto;
    text-style: bold;
    color: #f8fafc;
}

#export-conflict-message {
    height: auto;
    color: #94a3b8;
    margin-bottom: 1;
}

#export-conflict-scroll {
    height: 1fr;
    min-height: 3;
    border: round #334155;
    background: #111827;
    padding: 0 1;
}

#export-conflict-paths {
    height: auto;
    color: #7dd3fc;
    overflow: auto;
}

#export-conflict-actions {
    height: auto;
    layout: horizontal;
    margin-top: 1;
}

#export-conflict-actions Button {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

#export-conflict-actions #export-conflict-cancel {
    margin-right: 0;
}

#pattern-confirmation {
    align: center middle;
    background: rgba(15, 23, 42, 0.78);
}

#pattern-confirmation-card {
    width: 96%;
    height: 92%;
    border: round #38bdf8;
    background: #0b1220;
    padding: 0 1;
}

#pattern-confirmation-title {
    height: auto;
    text-style: bold;
    color: #f8fafc;
}

#pattern-confirmation-message {
    height: auto;
    max-height: 4;
    color: #fbbf24;
    margin-bottom: 1;
    overflow: auto;
}

#pattern-candidates {
    height: 1fr;
    min-height: 3;
    border: round #334155;
    background: #111827;
    padding: 0 1;
}

.pattern-candidate {
    height: auto;
    padding: 0 0 1 0;
    margin-bottom: 1;
    border-bottom: solid #334155;
}

.pattern-candidate-title {
    height: auto;
    color: #7dd3fc;
}

.pattern-candidate-pattern,
.pattern-candidate-preview {
    height: auto;
    color: #cbd5e1;
    overflow: auto;
}

.pattern-candidate-error {
    height: auto;
    color: #fca5a5;
}

#pattern-confirmation-actions {
    height: auto;
    margin-top: 1;
}

#pattern-confirmation-actions Button {
    width: 1fr;
    min-width: 0;
}

#output-actions #browse-events,
#output-actions #clear {
    width: 1fr;
}

#event-browser {
    align: center middle;
    background: rgba(15, 23, 42, 0.78);
}

#event-browser-card {
    width: 90%;
    height: 88%;
    border: round #38bdf8;
    background: #0b1220;
    padding: 1 2;
}

#browser-title {
    text-style: bold;
    color: #f8fafc;
}

#browser-page {
    color: #94a3b8;
    height: auto;
}

#browser-sort-hint {
    height: auto;
    color: #7dd3fc;
    margin-bottom: 1;
}

#event-options {
    height: 1fr;
    min-height: 3;
    border: round #334155;
    background: #111827;
}

#browser-controls {
    height: 6;
    layout: vertical;
}

#browser-query {
    width: 1fr;
    height: 3;
}

#browser-query-toolbar {
    height: 3;
    layout: horizontal;
}

#browser-query-toolbar Select {
    width: 1fr;
}

#browser-query-toolbar Button {
    width: 9;
    min-width: 0;
    margin-left: 1;
}

#browser-controls.wide {
    height: 3;
    layout: horizontal;
}

#browser-controls.wide #browser-query-toolbar {
    width: 42;
}

#browser-query-status {
    height: auto;
    max-height: 2;
    overflow-y: auto;
    color: #fbbf24;
}

#event-browser-card.short {
    height: 100%;
    padding: 0 1;
}

#event-browser-card.short #event-options {
    min-height: 1;
}

#event-browser-card.short #event-browser-actions {
    margin-top: 0;
}

#browser-preview-content {
    display: none;
    height: 1fr;
    min-height: 1;
}

#event-browser-preview-toolbar {
    height: auto;
    layout: vertical;
    margin: 1 0;
}

#event-browser-preview-toolbar.wide {
    layout: horizontal;
}

#event-browser-preview-toolbar Button {
    width: 1fr;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0;
    margin: 0;
}

#event-browser-preview-toolbar Button:focus {
    height: 1;
    border: none;
    padding: 0;
    text-style: bold underline;
    background: #263c55;
}

#event-browser-preview-toolbar.wide Button {
    margin: 0 1 0 0;
}

#source-warning {
    height: auto;
    color: #fbbf24;
    margin-bottom: 1;
}

#source-path {
    height: auto;
    min-height: 3;
    border: round #334155;
    background: #111827;
    color: #7dd3fc;
    padding: 1;
    overflow: auto;
}

#retained-details {
    height: auto;
    border: round #334155;
    background: #111827;
    padding: 1;
    margin-bottom: 1;
}

#source-context {
    height: auto;
    min-height: 5;
    border: round #334155;
    background: #111827;
    padding: 1;
    overflow: auto;
}

#copy-feedback {
    height: auto;
    color: #fbbf24;
    margin-top: 1;
}

#event-browser-actions {
    dock: bottom;
    height: auto;
    margin-top: 1;
    layout: grid;
    grid-size: 3 2;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: auto auto;
    grid-gutter: 0 1;
}

#event-browser-actions Button {
    width: 1fr;
    min-width: 0;
    height: auto;
    margin: 0;
}

#recipe-dialog {
    align: center middle;
    background: rgba(15, 23, 42, 0.78);
}

#recipe-dialog-card {
    width: 90%;
    height: 90%;
    border: round #38bdf8;
    background: #0b1220;
    padding: 1 2;
}

#recipe-content {
    height: 1fr;
    overflow: auto;
}

#recipe-title {
    text-style: bold;
    color: #f8fafc;
    margin-bottom: 1;
}

#recipe-selection,
#recipe-name {
    width: 1fr;
    margin-bottom: 1;
}

#recipe-status {
    height: auto;
    min-height: 1;
    color: #fbbf24;
    margin-top: 1;
}

#recipe-actions {
    height: auto;
    layout: horizontal;
    margin-top: 1;
}

#recipe-actions Button {
    width: 1fr;
    min-width: 8;
    margin-right: 1;
}

#recipe-actions #recipe-close {
    margin-right: 0;
}
