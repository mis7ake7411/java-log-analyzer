/* ── 內容容器 ── */

#content {
    height: 1fr;
    min-height: 0;
    min-width: 0;
    layout: vertical;
    overflow: hidden;
}

#form-panel,
#output-panel {
    border: round #334155;
    background: #0b1220;
    padding: 1 2;
    min-height: 0;
    min-width: 0;
}

#form-column {
    height: 1fr;
    min-height: 0;
    min-width: 0;
    layout: vertical;
}

#form-panel {
    margin-bottom: 1;
    overflow: auto;
    padding: 1 0 1 2;
}

#export-settings {
    height: auto;
    width: 1fr;
    layout: vertical;
    margin-top: 1;
    padding: 1;
    border: round #334155;
    background: #0f172a;
}

#export-fields {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: auto;
    height: auto;
}

#export-fields Checkbox {
    width: 1fr;
    margin-right: 1;
}

#export-status {
    height: auto;
    min-height: 1;
    margin-top: 1;
    color: #fca5a5;
}

#manifest-hint {
    margin-bottom: 1;
}

#confirm-export {
    width: 1fr;
}

/* ── 路徑列 ── */

.path-row {
    height: auto;
    width: 1fr;
    layout: horizontal;
}

.path-row Input {
    width: 1fr;
}

.path-row Button {
    width: 10;
    margin-left: 1;
}

.path-row.compact-buttons Button {
    width: 8;
}

/* ── 結果與動作區 ── */

#output-panel {
    height: 18;
    min-height: 12;
}

#result-status {
    height: 1;
    margin-bottom: 1;
    color: #94a3b8;
}

#result-box {
    height: 1fr;
    width: 1fr;
    min-height: 0;
    min-width: 0;
    border: round #334155;
    background: #111827;
}

#form-actions {
    height: 3;
    margin-top: 1;
    margin-bottom: 2;
    width: 1fr;
    min-width: 0;
}

#form-actions Button {
    width: 1fr;
}

#recipe-feedback {
    display: none;
    height: auto;
    min-height: 0;
    min-width: 0;
    margin: -1 3 1 3;
    color: #fbbf24;
}

#output-actions {
    height: 3;
    margin-top: 1;
    width: 1fr;
    min-width: 0;
    layout: horizontal;
}

#output-actions Button {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

.zero-results-hidden {
    display: none;
}

#zero-result-actions {
    height: 3;
    margin-top: 1;
    layout: horizontal;
}

#zero-result-actions Button {
    width: 1fr;
}
