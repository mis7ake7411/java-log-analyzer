/* ── Hero 響應式排版 ── */

#hero-title-row.wide {
    layout: horizontal;
}

#hero-title-row.wide #hero-title,
#hero-title-row.wide #hero-version,
#hero-title-row.wide #hero-separator {
    margin-right: 1;
}

#hero-title-row.compact {
    layout: horizontal;
    width: 1fr;
}

#hero.compact {
    padding: 0 2;
    margin-bottom: 0;
}

#hero-title-row.compact #hero-separator,
#hero-title-row.compact #hero-subtitle {
    display: none;
}

#hero-title-row.compact #hero-version {
    margin-left: 1;
}

/* ── Content 響應式排版 ── */

#content.wide {
    layout: horizontal;
}

#content.compact {
    layout: vertical;
}

#content.wide #form-column {
    width: 1fr;
    min-width: 50;
    margin-right: 1;
    height: 1fr;
}

#content.wide #form-panel {
    margin-bottom: 1;
    height: 1fr;
}

#content.wide #output-panel {
    width: 1fr;
    margin-right: 1;
    height: 1fr;
    min-height: 0;
}

#content.compact #form-column {
    width: 1fr;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 1;
    height: 1fr;
    min-height: 8;
}

#content.compact #form-panel {
    width: 100%;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 1;
    height: 1fr;
    min-height: 0;
    overflow: auto;
}

#content.compact #output-panel {
    width: 1fr;
    min-width: 0;
    height: 1fr;
    min-height: 8;
}

/* Give the dashboard useful reading space without moving either action row off screen. */
#content.compact #output-panel {
    padding: 0 1;
}

#content.compact.has-result #output-panel {
    height: 2fr;
}

#content.compact #form-column {
    min-height: 9;
}

#shell.compact.short.has-result #hero {
    display: none;
}

#content.compact #result-box {
    border: none;
}

#content.compact #output-panel > .section-title {
    margin-bottom: 0;
}

#content.compact #result-status {
    margin-bottom: 0;
}

#content.compact #output-actions {
    margin-top: 0;
}
