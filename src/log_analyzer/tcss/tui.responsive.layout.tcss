/* ── Hero 響應式排版 ── */

#hero-title-row.wide {
    layout: horizontal;
}

#hero-title-row.wide #hero-title,
#hero-title-row.wide #hero-version,
#hero-title-row.wide #hero-separator {
    margin-right: 1;
}

#hero-title-row.compact {
    layout: vertical;
}

#hero-title-row.compact #hero-separator {
    display: none;
}

#hero-title-row.compact #hero-version {
    margin-left: 0;
}

/* ── Content 響應式排版 ── */

#content.wide {
    layout: horizontal;
}

#content.compact {
    layout: vertical;
}

#content.wide #form-column {
    width: 1fr;
    min-width: 50;
    margin-right: 1;
    height: 1fr;
}

#content.wide #form-panel {
    margin-bottom: 1;
    height: 1fr;
}

#content.wide #output-panel {
    width: 1fr;
    margin-right: 1;
    height: 1fr;
    min-height: 0;
}

#content.compact #form-column {
    width: auto;
    margin-right: 0;
    margin-bottom: 1;
    height: 1fr;
    min-height: 8;
}

#content.compact #form-panel {
    width: auto;
    margin-right: 0;
    margin-bottom: 1;
    height: 1fr;
    min-height: 0;
    overflow: auto;
}

#content.compact #output-panel {
    width: auto;
    height: 1fr;
    min-height: 8;
}
