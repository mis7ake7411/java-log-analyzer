
/* ── Form Panel 基底 ── */

#form-panel.wide {
    padding: 1 0 1 2;
}

#form-panel.compact {
    padding: 1 0 1 1;
}

#form-panel.wide .field,
#form-panel.wide .field-row,
#form-panel.wide .time-section,
#form-panel.wide #actions,
#form-panel.wide .helper {
    margin-right: 2;
}

#form-panel.wide #advanced-settings .time-section,
#form-panel.wide #advanced-settings #actions,
#form-panel.wide #advanced-settings .helper {
    margin-right: 2;
}

#form-panel.compact .field,
#form-panel.compact .field-row,
#form-panel.compact .time-section,
#form-panel.compact #actions,
#form-panel.compact .helper {
    margin-right: 2;
}

/* ── 標準欄位 ── */

#form-panel.wide .field {
    layout: horizontal;
    margin-bottom: 0;
}

#form-panel.compact .field {
    layout: vertical;
    margin-bottom: 0;
}

#form-panel.wide .field > Label {
    width: 10;
    margin-right: 1;
    margin-bottom: 0;
}

#form-panel.wide .field > Input,
#form-panel.wide .field > Select {
    width: 1fr;
}

#form-panel.wide .field > Checkbox {
    width: auto;
}

#form-panel.compact .time-section > Label {
    margin-bottom: 0;
}

/* ── 列型欄位 ── */

#form-panel.wide .field-row {
    layout: horizontal;
    width: 1fr;
    margin-bottom: 0;
}

#form-panel.compact .field-row {
    layout: vertical;
    margin-bottom: 1;
}

#form-panel.wide .field-row .field--ignore {
    width: auto;
    layout: horizontal;
    align: left middle;
    margin-right: 1;
}

#form-panel.wide .field-row .field--display-mode {
    width: 1fr;
    margin-right: 0;
}

#form-panel.wide .field-row .field--sort {
    width: 1fr;
    margin-right: 1;
}

#form-panel.wide .field-row .field--format {
    width: 1fr;
    margin-right: 1;
}

#form-panel.wide .field-row .field--split-output {
    width: auto;
    layout: horizontal;
    align: left middle;
    margin-right: 0;
}

#form-panel.compact .field-row .field--ignore,
#form-panel.compact .field-row .field--display-mode,
#form-panel.compact .field-row .field--sort,
#form-panel.compact .field-row .field--format,
#form-panel.compact .field-row .field--split-output {
    width: auto;
    margin-bottom: 0;
}

#form-panel.wide .field-row .field--format > Select {
    width: 1fr;
    margin-right: 2;
}

#form-panel.wide .field-row .field--sort > Select {
    width: 1fr;
}

#form-panel.wide .field-row .field--ignore > Checkbox {
    width: auto;
    margin-top: 0;
    margin-left: 1;
}

#form-panel.wide .field-row .field--split-output > Checkbox {
    width: auto;
    margin-top: 0;
    margin-left: 1;
}

#form-panel.compact .field-row .field--format > Select {
    width: 1fr;
}

#form-panel.compact .field-row .field--sort > Select {
    width: 1fr;
}

#form-panel.wide .level-filter-row {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: auto;
}

#form-panel.wide .level-filter-row Checkbox {
    width: 1fr;
    margin-right: 0;
}

#form-panel.wide #clear_levels {
    margin-left: 1;
}

#form-panel.compact .level-filter-row {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto;
}

#form-panel.compact .level-filter-row Checkbox {
    width: 1fr;
    margin-right: 0;
}

#form-panel.compact .level-filter-actions {
    layout: vertical;
}

#form-panel.compact .level-filter-actions Button {
    width: 1fr;
}

#form-panel.compact #clear_levels {
    margin-top: 1;
    margin-left: 0;
}
