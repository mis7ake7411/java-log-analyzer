LivePanel {
    width: 1fr;
    height: 1fr;
    min-width: 0;
    min-height: 0;
    padding: 0 1;
    border: round #334155;
    background: #0b1220;
}

LivePanel #live-content-scroll {
    width: 1fr;
    height: 1fr;
    min-width: 0;
    min-height: 3;
    overflow-y: auto;
}

LivePanel #live-actions,
LivePanel #live-actions-secondary,
LivePanel #live-reading-controls {
    width: 1fr;
    min-width: 0;
    layout: horizontal;
    overflow: hidden;
}

LivePanel #live-actions {
    height: 2;
}

LivePanel #live-actions-secondary {
    height: 1;
}

LivePanel #live-reading-controls {
    height: 2;
}

LivePanel #live-switch-label {
    width: 4;
    min-width: 4;
    height: 2;
    color: #cbd5e1;
    content-align: left middle;
}

LivePanel #live-switch {
    width: 6;
    min-width: 6;
    height: 2;
    padding: 0;
}

LivePanel #live-actions Button,
LivePanel #live-actions-secondary Button,
LivePanel #live-reading-controls Button {
    width: 6;
    min-width: 6;
    max-width: 6;
    margin: 0;
    padding: 0;
}

LivePanel #live-reading-controls Button {
    height: 1;
    min-height: 1;
    max-height: 1;
}

LivePanel #live-actions Button,
LivePanel #live-actions-secondary Button {
    width: auto;
    min-width: 4;
    max-width: 20;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    color: #7dd3fc;
    background: #17283b;
}

LivePanel #live-actions #live-rebuild {
    margin-left: 1;
}

LivePanel #live-rebuild-warning {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 2;
    color: #fbbf24;
    text-wrap: wrap;
}

LivePanel #live-actions Button:focus,
LivePanel #live-actions-secondary Button:focus,
LivePanel #live-reading-controls Button:focus {
    color: #f8fafc;
    background: #263c55;
    text-style: bold underline;
}

LivePanel #live-actions Button:disabled,
LivePanel #live-actions-secondary Button:disabled,
LivePanel #live-reading-controls Button:disabled {
    color: #64748b;
    background: transparent;
}

LivePanel #live-follow {
    width: 12;
    min-width: 12;
    height: 2;
    padding: 0;
    color: #cbd5e1;
}

LivePanel #live-page {
    width: 5;
    min-width: 5;
    height: 1;
    margin-left: 0;
    color: #94a3b8;
    content-align: center middle;
}

LivePanel #live-new-events {
    width: 1fr;
    height: 1;
    color: #fbbf24;
    content-align: left middle;
}

LivePanel #live-status {
    width: 1fr;
    height: auto;
    min-height: 5;
    max-height: 7;
    color: #cbd5e1;
    text-wrap: wrap;
}

LivePanel #live-events {
    width: 1fr;
    height: 1fr;
    min-width: 0;
    min-height: 3;
    border: round #1e3a5f;
    background: #08111e;
    color: #e2e8f0;
    text-wrap: wrap;
}

LivePanel #live-events > .option-list--option-highlighted {
    color: #f8fafc;
    background: #1e3a5f;
    text-style: bold;
}

#output-panel > #live-summary-metadata {
    width: 1fr;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    color: #cbd5e1;
    text-wrap: wrap;
}

#output-panel > #live-summary-details {
    width: auto;
    min-width: 20;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    color: #7dd3fc;
    background: transparent;
}

#shell.compact.short #content.live-summary #form-column {
    display: none;
}

#shell.compact.short #content.live-summary #output-panel {
    height: 1fr;
    min-height: 0;
}

#shell.compact.short #content.live-mode #form-column {
    height: 4;
    min-height: 4;
}

#shell.compact.short #content.live-mode #output-panel {
    height: 1fr;
    min-height: 0;
}

LiveSummaryDetailsScreen {
    align: center middle;
}

#live-summary-details-dialog {
    width: 90%;
    max-width: 90;
    height: 85%;
    max-height: 30;
    border: round #334155;
    padding: 1 2;
    background: #0b1220;
}

#live-summary-details-scroll {
    width: 1fr;
    height: 1fr;
    min-height: 0;
    border: round #1e3a5f;
    padding: 0 1;
}

#live-summary-details-content {
    width: 1fr;
    height: auto;
}

#live-summary-details-close {
    width: 1fr;
    margin-top: 1;
}
