
/* ── 路徑與按鈕 ── */

#form-panel.wide .path-row Button {
    margin-right: 2;
}

#form-panel.compact .path-row {
    layout: horizontal;
}

#form-panel.compact .path-row Input {
    width: 1fr;
}

#form-panel.compact .path-row Button {
    width: 8;
    margin-left: 1;
    margin-top: 0;
}

#form-panel.compact .path-row.compact-buttons Button {
    width: 8;
}

#form-panel.wide .path-status {
    margin-left: 11;
}

#form-panel.compact .path-status {
    margin-left: 0;
}

/* ── 時間區間 ── */

#form-panel.wide .time-section {
    layout: horizontal;
    margin-bottom: 0;
}

#form-panel.compact .time-section {
    layout: vertical;
    margin-bottom: 1;
}

#form-panel.wide .time-section > Label {
    width: 10;
    margin-right: 1;
    margin-bottom: 0;
}

#form-panel.wide .time-stack {
    width: 1fr;
}

#form-panel.compact .time-stack {
    width: auto;
}

#form-panel.compact .time-group {
    width: auto;
    margin-right: 0;
    margin-bottom: 0;
}

/* ── 進階區塊專用 ── */

#form-panel.wide #advanced-settings .time-section {
    layout: vertical;
    width: 1fr;
    margin-bottom: 0;
}

#form-panel.wide #advanced-settings .time-stack {
    width: 1fr;
    min-width: 0;
}

#form-panel.wide #advanced-settings .field > Label {
    width: 14;
}

#form-panel.wide #advanced-settings .path-row Button {
    min-width: 0;
}

#form-panel.wide #advanced-settings .time-row {
    width: 1fr;
    min-width: 0;
}

#form-panel.wide #advanced-settings .time-group {
    min-width: 14;
}

#form-panel.wide #advanced-settings .time-section > Label {
    margin-bottom: 1;
}

/* ── 進階按鈕列 ── */

#form-panel.wide .advanced-toggle {
    margin-right: 2;
}

#form-panel.compact .helper {
    margin-top: 0;
}

#form-actions.wide Button,
#form-actions.compact Button {
    min-width: 0;
}

#form-actions.wide {
    layout: horizontal;
}

#form-actions.wide #manage-recipes {
    width: 18;
}

#form-actions.wide #run {
    width: 1fr;
}

#form-actions.compact {
    layout: horizontal;
}

#form-actions.compact #manage-recipes {
    width: 18;
}

#form-actions.compact #run {
    width: 1fr;
}

/* Advanced settings reflow from their own content width, not viewport width. */
#shell.compact {
    padding: 0 2;
}

#form-panel.compact {
    padding: 0 0 0 1;
}

#form-actions.compact {
    margin-top: 0;
    margin-bottom: 1;
}

#content.compact.short #form-column {
    margin-bottom: 0;
}

#content.compact.short #form-actions {
    margin-bottom: 0;
}

#advanced-settings.advanced-compact,
#advanced-settings.advanced-wide {
    min-width: 0;
    width: 1fr;
}

#advanced-settings.advanced-compact .field {
    layout: vertical;
    width: 1fr;
    min-width: 0;
    margin-right: 0;
}

#advanced-settings.advanced-compact .field > Label,
#advanced-settings.advanced-compact .field > Input,
#advanced-settings.advanced-compact .field > Select,
#advanced-settings.advanced-compact .field-body {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-compact .field > Label {
    margin-right: 0;
    margin-bottom: 0;
}

#advanced-settings.advanced-compact .path-row {
    width: 1fr;
    min-width: 0;
    layout: horizontal;
}

#advanced-settings.advanced-compact .path-row Input {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-compact .path-row Button {
    width: 8;
    min-width: 0;
    margin: 0 0 0 1;
}

#advanced-settings.advanced-compact .time-section {
    width: 1fr;
    min-width: 0;
    layout: vertical;
    margin-right: 0;
    margin-bottom: 0;
}

#advanced-settings.advanced-compact .time-section > Label {
    width: 1fr;
    margin: 0;
}

#advanced-settings.advanced-compact .time-stack,
#advanced-settings.advanced-compact .time-row {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-compact .time-row {
    layout: horizontal;
}

#advanced-settings.advanced-compact .time-group {
    layout: vertical;
    width: 1fr;
    min-width: 0;
    margin-right: 1;
    margin-bottom: 0;
}

#advanced-settings.advanced-compact .time-group > Label,
#advanced-settings.advanced-compact .time-group > Input {
    width: 1fr;
    min-width: 0;
    margin: 0;
}

#advanced-settings.advanced-compact .field-row {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    width: 1fr;
    min-width: 0;
    margin-right: 0;
}

#advanced-settings.advanced-compact .field-row .field {
    width: 1fr;
}

#advanced-settings.advanced-compact .level-filter-row {
    grid-size: 2;
    grid-columns: 1fr 1fr;
}

#advanced-settings.advanced-wide .field {
    layout: horizontal;
    width: 1fr;
    min-width: 0;
    margin-right: 0;
}

#advanced-settings.advanced-wide .field > Label {
    width: 12;
    min-width: 0;
    margin: 0 1 0 0;
}

#advanced-settings.advanced-wide .field > Input,
#advanced-settings.advanced-wide .field > Select,
#advanced-settings.advanced-wide .field-body {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-wide .path-row {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-wide .path-row Input {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-wide .path-row Button {
    min-width: 0;
    margin-right: 0;
}

#advanced-settings.advanced-wide .time-section {
    width: 1fr;
    min-width: 0;
    layout: horizontal;
    margin-right: 0;
    margin-bottom: 0;
}

#advanced-settings.advanced-wide .time-section > Label {
    width: 12;
    min-width: 0;
    margin: 0 1 0 0;
}

#advanced-settings.advanced-wide .time-stack,
#advanced-settings.advanced-wide .time-row {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-wide .time-row,
#advanced-settings.advanced-wide .time-group {
    layout: horizontal;
}

#advanced-settings.advanced-wide .time-group {
    width: 1fr;
    min-width: 0;
    margin-right: 1;
}

#advanced-settings.advanced-wide .time-group > Label {
    width: 10;
    min-width: 0;
    margin: 0 1 0 0;
}

#advanced-settings.advanced-wide .time-group > Input {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-wide .field-row {
    layout: horizontal;
    width: 1fr;
    min-width: 0;
    margin-right: 0;
}

#advanced-settings.advanced-wide .field-row .field {
    width: 1fr;
    min-width: 0;
}

#advanced-settings.advanced-wide .level-filter-row {
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
}

#advanced-settings.advanced-wide .level-filter-actions {
    layout: horizontal;
}

#advanced-settings.advanced-wide .level-filter-actions Button {
    width: 1fr;
    min-width: 0;
}
